/* ==========================================================
   ACTION REPRISE
   Interface Base Entreprises
   ========================================================== */


/* ==========================================================
   FENÊTRE PRINCIPALE
   ========================================================== */

QMainWindow {
    background-color: #F4F5F7;
}

#centralWidget {
    background-color: #F4F5F7;
}


/* ==========================================================
   TEXTE GÉNÉRAL
   ========================================================== */

QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
    color: #303030;
}


/* ==========================================================
   TITRE
   ========================================================== */

#mainTitle {
    color: #303030;
    font-size: 23px;
    font-weight: 700;
}

#subTitle {
    color: #777777;
    font-size: 10pt;
}


/* ==========================================================
   COMPTEUR
   ========================================================== */

#counter {
    background-color: #FFFFFF;
    color: #B51F23;

    border: 1px solid #E3E3E3;
    border-radius: 20px;

    padding: 8px 18px;

    font-size: 10pt;
    font-weight: 600;
}


/* ==========================================================
   CARTE RECHERCHE
   ========================================================== */

#searchCard {
    background-color: #FFFFFF;

    border: 1px solid #E1E3E6;
    border-radius: 9px;
}


#searchLabel {
    color: #303030;

    font-size: 10pt;
    font-weight: 600;
}


/* ==========================================================
   CHAMP RECHERCHE
   ========================================================== */

#searchInput {
    background-color: #F8F9FA;

    border: 1px solid #D9DDE2;
    border-radius: 7px;

    padding: 9px 12px;

    color: #303030;

    selection-background-color: #B51F23;
}


#searchInput:hover {
    border: 1px solid #C8CBD0;
}


#searchInput:focus {
    background-color: #FFFFFF;

    border: 1px solid #B51F23;
}


/* ==========================================================
   TABLEAU
   ========================================================== */

#entrepriseTable {
    background-color: #FFFFFF;

    border: 1px solid #E0E2E5;
    border-radius: 9px;

    gridline-color: transparent;

    selection-background-color: #F7E3E4;
    selection-color: #303030;

    outline: none;
}


/* ==========================================================
   CELLULES TABLEAU
   ========================================================== */

QTableView::item {
    padding-left: 8px;
    padding-right: 8px;

    border: none;
}


QTableView::item:hover {
    background-color: #FCF1F1;
}


QTableView::item:selected {
    background-color: #F7E3E4;

    color: #303030;
}


/* ==========================================================
   HEADER TABLEAU
   ========================================================== */

QHeaderView {
    background-color: #303030;
}


QHeaderView::section {
    background-color: #303030;

    color: #FFFFFF;

    padding: 10px 8px;

    border: none;
    border-right: 1px solid #474747;

    font-weight: 600;
}


QHeaderView::section:hover {
    background-color: #B51F23;
}


QHeaderView::section:pressed {
    background-color: #991A1D;
}


/* ==========================================================
   CARTE ACTIONS
   ========================================================== */

#actionsCard {
    background-color: #FFFFFF;

    border: 1px solid #E1E3E6;
    border-radius: 9px;
}


/* ==========================================================
   TEXTE INFO
   ========================================================== */

#infoText {
    color: #777777;

    font-size: 9pt;
}


/* ==========================================================
   BOUTONS
   ========================================================== */

QPushButton {
    min-height: 36px;

    padding-left: 18px;
    padding-right: 18px;

    border-radius: 7px;

    font-size: 10pt;
    font-weight: 600;
}


/* ==========================================================
   BOUTON IMPORT
   ========================================================== */

#importButton {
    background-color: #303030;

    color: #FFFFFF;

    border: 1px solid #303030;
}


#importButton:hover {
    background-color: #454545;

    border-color: #454545;
}


#importButton:pressed {
    background-color: #242424;
}


#importButton:disabled {
    background-color: #9A9A9A;

    border-color: #9A9A9A;

    color: #FFFFFF;
}


/* ==========================================================
   BOUTON EXPORT
   ========================================================== */

#exportButton {
    background-color: #B51F23;

    color: #FFFFFF;

    border: 1px solid #B51F23;
}


#exportButton:hover {
    background-color: #991A1D;

    border-color: #991A1D;
}


#exportButton:pressed {
    background-color: #801518;

    border-color: #801518;
}


#exportButton:disabled {
    background-color: #C88C8E;

    border-color: #C88C8E;

    color: #FFFFFF;
}


/* ==========================================================
   BOUTONS GÉNÉRAUX
   ========================================================== */

QPushButton {
    background-color: #FFFFFF;

    color: #303030;

    border: 1px solid #D5D8DC;
}


QPushButton:hover {
    background-color: #F7F7F7;

    border-color: #B51F23;
}


QPushButton:pressed {
    background-color: #ECECEC;
}


/* ==========================================================
   SCROLLBAR VERTICALE
   ========================================================== */

QScrollBar:vertical {
    background-color: #F4F5F7;

    width: 10px;

    margin: 0;
}


QScrollBar::handle:vertical {
    background-color: #C7C9CC;

    border-radius: 5px;

    min-height: 35px;
}


QScrollBar::handle:vertical:hover {
    background-color: #9FA1A4;
}


QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}


/* ==========================================================
   SCROLLBAR HORIZONTALE
   ========================================================== */

QScrollBar:horizontal {
    background-color: #F4F5F7;

    height: 10px;

    margin: 0;
}


QScrollBar::handle:horizontal {
    background-color: #C7C9CC;

    border-radius: 5px;

    min-width: 35px;
}


QScrollBar::handle:horizontal:hover {
    background-color: #9FA1A4;
}


QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}


/* ==========================================================
   MESSAGE BOX
   ========================================================== */

QMessageBox {
    background-color: #FFFFFF;
}


QMessageBox QLabel {
    color: #303030;
}


QMessageBox QPushButton {
    min-width: 90px;
}


/* ==========================================================
   DIALOGS
   ========================================================== */

QDialog {
    background-color: #F4F5F7;
}


QDialog QLabel {
    color: #303030;
}


/* ==========================================================
   COMBOBOX
   ========================================================== */

QComboBox {
    background-color: #FFFFFF;

    border: 1px solid #D9DDE2;
    border-radius: 7px;

    padding: 8px 10px;
}


QComboBox:hover {
    border-color: #B51F23;
}


QComboBox:focus {
    border-color: #B51F23;
}


/* ==========================================================
   CHECKBOX
   ========================================================== */

QCheckBox {
    spacing: 8px;
}


QCheckBox::indicator {
    width: 17px;
    height: 17px;
}


QCheckBox::indicator:unchecked {
    background-color: #FFFFFF;

    border: 1px solid #C7C9CC;

    border-radius: 4px;
}


QCheckBox::indicator:checked {
    background-color: #B51F23;

    border: 1px solid #B51F23;

    border-radius: 4px;
}


/* ==========================================================
   TOOLTIPS
   ========================================================== */

QToolTip {
    background-color: #303030;

    color: #FFFFFF;

    border: 1px solid #303030;

    padding: 6px;

    border-radius: 4px;
}


/* ==========================================================
   FILTRES - MENU
   ========================================================== */

#filterMenu {
    background-color: #FFFFFF;

    color: #303030;

    border: 1px solid #D9DDE2;

    border-radius: 8px;

    padding: 5px;
}


/* ==========================================================
   FILTRES - CONTENU
   ========================================================== */

#filterWidget {
    background-color: #FFFFFF;

    color: #303030;
}


/* ==========================================================
   FILTRES - LISTE
   ========================================================== */

#filterList {
    background-color: #FFFFFF;

    color: #303030;

    border: 1px solid #E1E3E6;

    border-radius: 7px;

    outline: none;
}


#filterList::item {
    background-color: #FFFFFF;

    color: #303030;

    padding: 7px 8px;

    border-radius: 5px;
}


#filterList::item:hover {
    background-color: #FCF1F1;

    color: #303030;
}


#filterList::item:selected {
    background-color: #F7E3E4;

    color: #303030;
}


/* ==========================================================
   FILTRES - BOUTON OK
   ========================================================== */

#filterApplyButton {
    background-color: #B51F23;

    color: #FFFFFF;

    border: 1px solid #B51F23;

    border-radius: 7px;

    padding: 7px 18px;
}


#filterApplyButton:hover {
    background-color: #991A1D;

    border-color: #991A1D;
}


#filterApplyButton:pressed {
    background-color: #801518;

    border-color: #801518;
}


/* ==========================================================
   FILTRES - BOUTON ANNULER
   ========================================================== */

#filterCancelButton {
    background-color: #FFFFFF;

    color: #303030;

    border: 1px solid #D5D8DC;

    border-radius: 7px;

    padding: 7px 18px;
}


#filterCancelButton:hover {
    background-color: #F7F7F7;

    border-color: #B51F23;
}


/* ==========================================================
   FILTRES - CASES À COCHER
   ========================================================== */

#filterList::indicator {
    width: 16px;
    height: 16px;
}


#filterList::indicator:unchecked {
    background-color: #FFFFFF;

    border: 1px solid #C7C9CC;

    border-radius: 4px;
}


#filterList::indicator:checked {
    background-color: #B51F23;

    border: 1px solid #B51F23;

    border-radius: 4px;
}


/* ==========================================================
   FILTRES - SCROLLBAR
   ========================================================== */

#filterList QScrollBar:vertical {
    background-color: #F4F5F7;

    width: 9px;

    margin: 0;
}


#filterList QScrollBar::handle:vertical {
    background-color: #C7C9CC;

    border-radius: 4px;

    min-height: 30px;
}


#filterList QScrollBar::handle:vertical:hover {
    background-color: #9FA1A4;
}


#filterList QScrollBar::add-line:vertical,
#filterList QScrollBar::sub-line:vertical {
    height: 0;
}